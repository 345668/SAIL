{
  "name": "anker-company-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Anker Company Administration Portal — platform-owner app, separate auth, firewalled from the tenant Venture OS.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
